# Copy this file to backend/.env and fill in real values.
# The backend fails to start if any required value is missing.

# --- Database ---
DATABASE_URL=sqlite:///./saas.db

# --- JWT auth (REQUIRED) ---
# Generate a strong value:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# Access tokens are short-lived and silently renewed by a rotating refresh
# token. Defaults are sensible; override only if you have a reason.
# ACCESS_TOKEN_TTL_MINUTES=30
# REFRESH_TOKEN_TTL_DAYS=30

# --- Credential encryption (REQUIRED) ---
# 32-byte url-safe base64 key:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Optional: shared rate-limit store ---
# Set REDIS_URL to enforce auth rate limits ACROSS instances (required before
# running more than one backend instance). Unset = per-process in-memory limiter.
# REDIS_URL=redis://localhost:6379/0

# --- Google OAuth / GA4 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: deployment URLs ---
# BACKEND_URL must match the redirect URI registered in Google Cloud Console:
#   <BACKEND_URL>/api/v1/integrations/google/callback
# BACKEND_URL=https://your-backend.onrender.com
# FRONTEND_URL=https://your-frontend.vercel.app

# --- Optional: extra CORS origins (comma-separated). localhost + *.vercel.app
# are always allowed; add custom domains here. ---
# CORS_ORIGINS=https://app.yourdomain.com,https://www.yourdomain.com

# --- Optional: transactional email (verification + password reset) ---
# Without RESEND_API_KEY, emails are logged to the console instead of sent, so
# the flows still work in dev. Sign up at resend.com for a key.
# RESEND_API_KEY=
# EMAIL_FROM=ArbFlow <onboarding@resend.dev>
# When "true", unverified accounts can't log in. Default off so nobody is locked
# out before email is configured.
# REQUIRE_EMAIL_VERIFICATION=false

# --- Optional: error tracking ---
# SENTRY_DSN=

# --- Optional: session cookie ---
# The session JWT is set as an httpOnly Secure cookie. Secure works on
# http://localhost in Chrome/Firefox; set to false only if your local browser
# refuses the cookie. NEVER false in production.
# COOKIE_SECURE=true

# --- Optional: Meta & LinkedIn (scaffolded) ---
# META_APP_ID=
# META_APP_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
